# Copy to .env at the repository root:  cp infra/.env.example .env
#
# Development defaults only. Never commit a real .env — it is gitignored.
# Every variable here is read through common/ (P0-07); no service reads
# os.environ directly.

# --- Environment ------------------------------------------------------------
COURIER_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL + PostGIS (orders, drones, missions, airspace) --------------
POSTGRES_USER=courier
POSTGRES_PASSWORD=courier_dev
POSTGRES_DB=courier
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://courier:courier_dev@localhost:5432/courier

# --- TimescaleDB (drone_state hypertable) -----------------------------------
TIMESCALE_USER=courier
TIMESCALE_PASSWORD=courier_dev
TIMESCALE_DB=courier_telemetry
TIMESCALE_PORT=5433
TELEMETRY_DATABASE_URL=postgresql+asyncpg://courier:courier_dev@localhost:5433/courier_telemetry

# --- Redis (live drone state) -----------------------------------------------
REDIS_PORT=6379
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://localhost:6379/0

# --- NATS (internal pub/sub) ------------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# --- Gateway (P1-02) --------------------------------------------------------
# UDP socket the MAVLink stream arrives on.
MAVLINK_BIND_HOST=0.0.0.0
MAVLINK_BIND_PORT=14445
# A vehicle not refreshed within this window counts as link-lost; matches the
# Redis TTL in ARCHITECTURE.md §1.
LINK_TIMEOUT_S=15

# --- Agent / ground relay (P1-01) -------------------------------------------
# The loopback socket QGC forwards to on the ground station PC.
MAVLINK_LISTEN_HOST=127.0.0.1
MAVLINK_LISTEN_PORT=14445
GATEWAY_URL=ws://localhost:8080/ingest
# Per-vehicle credential. An unauthenticated relay is how a spoofed SYSID gets
# into the fleet view (P1-07). Generate a real one per ground station.
GATEWAY_TOKEN=replace-me
QUEUE_PATH=./relay-queue
