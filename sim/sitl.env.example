# Copy to sim/sitl.env:  cp sim/sitl.env.example sim/sitl.env
#
# sim/sitl.env is gitignored. Home location is deliberately NOT defaulted in
# run_sitl.sh — coordinates belong in configuration, never in code, and a
# forgotten default that quietly puts the fleet in the wrong country is exactly
# the class of bug that rule exists to prevent.

# Home location for instance 0, as "lat,lon,alt_amsl_m,heading_deg".
# WGS84 decimal degrees, altitude AMSL in metres, heading degrees true.
# Replace with your own test area before running.
#
# Note that this altitude is not checked against terrain. On 2026-09-25 this
# value put the fleet roughly 165 m *below* ground: SITL loads terrain tiles
# (336 of them) and reported `terrain_height` of 584-656 m at these
# coordinates, against a home of 450 m, so every vehicle's `current_height`
# came out negative. Harmless for an ingest test, and wrong the moment anything
# reasons about height above ground. Set this from the terrain elevation at
# your coordinates, not from a round number.
SITL_HOME=41.7151,44.8271,450,0

# Spacing between consecutive instances on the ground, metres east.
# Vehicles must not start stacked on top of each other.
SITL_SPACING_M=25

# First SYSID. Instance i gets SITL_SYSID_BASE + i, so the default gives
# SYSID 1..N. SYSID 0 is reserved and 255 is the ground station.
SITL_SYSID_BASE=1

# Per-vehicle UDP output. Instance i publishes on SITL_OUT_PORT_BASE + i.
# This is the port the Gateway and the integration tests read.
SITL_OUT_PORT_BASE=14560

# Shared UDP output that every instance also forwards to, so a single QGC
# link shows the whole fleet (QGC separates the vehicles by SYSID).
# Set empty to disable.
SITL_QGC_PORT=14550

# ArduPilot frame type and simulation speedup.
SITL_FRAME=quad
SITL_SPEEDUP=1

# Path to ArduPilot's sim_vehicle.py. Leave unset to take it from PATH.
#SIM_VEHICLE=/home/you/ardupilot/Tools/autotest/sim_vehicle.py
